<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    launchd plist — All-Weather Daily Snapshot
    ==========================================
    Runs live/daily_snapshot.py every weekday at 16:10 ET (after market close)
    to record a price + drift row in live/logs/daily_snapshots.csv.

    This plist does NOT place any orders.  It only fetches prices and records
    portfolio drift for later shadow-comparison analysis.

    Setup
    -----
    Generated by:  bash live/scheduler/install_launchd.sh --snapshot-only
    Or manually:
        cp live/scheduler/com.allweather.snapshot.plist.template \
           ~/Library/LaunchAgents/com.allweather.snapshot.plist
        # Edit all __PLACEHOLDER__ values
        launchctl load ~/Library/LaunchAgents/com.allweather.snapshot.plist

    Placeholders (same as rebalance plist)
    __PROJECT_ROOT__   : absolute path to the all-weather project root
    __CONDA_PYTHON__   : absolute path to the allweather conda Python
    __BROKER__         : alpaca | tastytrade
    __ACCOUNT__        : account label
    __MODE__           : --paper | --live
    __STRATEGY_ID__    : e.g. 6asset_tip_gsg_rpavg
    __LOG_DIR__        : absolute path to the logs directory
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.allweather.snapshot</string>

    <key>ProgramArguments</key>
    <array>
        <string>__CONDA_PYTHON__</string>
        <string>-m</string>
        <string>live.daily_snapshot</string>
        <string>__MODE__</string>
        <string>--broker</string>
        <string>__BROKER__</string>
        <string>--account</string>
        <string>__ACCOUNT__</string>
        <string>--strategy-id</string>
        <string>__STRATEGY_ID__</string>
    </array>

    <!-- Run every weekday at 16:10 ET = 21:10 UTC (after market close at 16:00 ET) -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>10</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>21</integer><key>Minute</key><integer>10</integer></dict>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/launchd_snapshot_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/launchd_snapshot_stderr.log</string>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>KeepAlive</key>
    <false/>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ALLW_API_KEYS_ENV</key>
        <string>/Users/franciscosimao/Documents/QuantFinance/api_keys.env</string>
    </dict>
</dict>
</plist>
