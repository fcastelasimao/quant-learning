# All Weather — API Keys
# Copy this file to ../api_keys.env (one directory above the repo root)
# and fill in your credentials. Never commit the real file.
#
# The live modules auto-load from the path set in ALLW_API_KEYS_ENV,
# or from ../../api_keys.env by default.

# --- Alpaca (default account) ---
ALPACA_API_KEY="PKXXXXXXXXXXXXXXXX"
ALPACA_SECRET_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Alpaca (named account, e.g. --account client) ---
# BROKER_ALPACA_CLIENT_KEY="PKXXXXXXXXXXXXXXXX"
# BROKER_ALPACA_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Tastytrade (default account) ---
# TASTYTRADE_PROVIDER_SECRET="your-provider-secret"
# TASTYTRADE_REFRESH_TOKEN="your-refresh-token"

# --- FMP (market data, optional) ---
# FMP_API_KEY="your-fmp-key"

# --- Notifications (optional, silent when unset) ---
# ALLW_SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
# ALLW_NOTIFY_EMAIL="you@example.com"
# ALLW_NOTIFY_SMTP_HOST="smtp.gmail.com"
# ALLW_NOTIFY_SMTP_PORT="587"
# ALLW_NOTIFY_SMTP_USER="you@example.com"
# ALLW_NOTIFY_SMTP_PASS="app-password"
