<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    launchd plist — All-Weather Rebalancer (preview/dry-execute)
    ============================================================
    This template runs a DRY-EXECUTE every weekday morning at 09:05 ET
    so you can inspect the rebalance plan and logs without placing real orders.

    To activate REAL EXECUTION change --dry-execute to --execute and review
    the cadence gate (--min-rebalance-interval-days).

    IMPORTANT: This plist runs --dry-execute only.  The --execute flag is
    intentionally absent.  Real money execution must be triggered manually
    after reviewing the dry-execute output.

    Setup
    -----
    1. Run scripts/install_launchd.sh to copy a filled-in version
       to ~/Library/LaunchAgents/.
    2. Or manually:
         cp live/scheduler/com.allweather.rebalance.plist.template \
            ~/Library/LaunchAgents/com.allweather.rebalance.plist
         # Edit all __PLACEHOLDER__ values
         launchctl load ~/Library/LaunchAgents/com.allweather.rebalance.plist

    Placeholders
    ------------
    __PROJECT_ROOT__   : absolute path to the all-weather project root
    __CONDA_PYTHON__   : absolute path to the allweather conda Python interpreter
                         e.g. /Users/<user>/opt/anaconda3/envs/allweather/bin/python
    __BROKER__         : alpaca | tastytrade
    __ACCOUNT__        : account label (default for the default account)
    __MODE__           : --paper | --live
    __STRATEGY_ID__    : e.g. 6asset_tip_gsg_rpavg
    __LOG_DIR__        : absolute path to the logs directory
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.allweather.rebalance</string>

    <key>ProgramArguments</key>
    <array>
        <string>__CONDA_PYTHON__</string>
        <string>-m</string>
        <string>live.rebalance</string>
        <string>__MODE__</string>
        <string>--broker</string>
        <string>__BROKER__</string>
        <string>--account</string>
        <string>__ACCOUNT__</string>
        <string>--strategy-id</string>
        <string>__STRATEGY_ID__</string>
        <string>--dry-execute</string>
        <!--
            Replace --dry-execute with --execute to place real orders.
            Cadence gate prevents double-execution within 31 days.
        -->
    </array>

    <!-- Run every weekday at 09:05 Eastern (14:05 UTC during ET, 15:05 during EST) -->
    <!-- Adjust Hour to match your timezone offset from UTC.                         -->
    <key>StartCalendarInterval</key>
    <array>
        <!-- Monday -->
        <dict>
            <key>Weekday</key><integer>1</integer>
            <key>Hour</key><integer>14</integer>
            <key>Minute</key><integer>5</integer>
        </dict>
        <!-- Tuesday -->
        <dict>
            <key>Weekday</key><integer>2</integer>
            <key>Hour</key><integer>14</integer>
            <key>Minute</key><integer>5</integer>
        </dict>
        <!-- Wednesday -->
        <dict>
            <key>Weekday</key><integer>3</integer>
            <key>Hour</key><integer>14</integer>
            <key>Minute</key><integer>5</integer>
        </dict>
        <!-- Thursday -->
        <dict>
            <key>Weekday</key><integer>4</integer>
            <key>Hour</key><integer>14</integer>
            <key>Minute</key><integer>5</integer>
        </dict>
        <!-- Friday -->
        <dict>
            <key>Weekday</key><integer>5</integer>
            <key>Hour</key><integer>14</integer>
            <key>Minute</key><integer>5</integer>
        </dict>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/launchd_rebalance_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/launchd_rebalance_stderr.log</string>

    <!-- Restart after 60s if the job crashes (not if it exits cleanly) -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <!-- Keep the job loaded even after it exits -->
    <key>KeepAlive</key>
    <false/>

    <!-- Run as the current user (not root) -->
    <key>RunAtLoad</key>
    <false/>

    <!-- Pass environment variables for credentials -->
    <key>EnvironmentVariables</key>
    <dict>
        <!-- Canonical secrets file. Broker/data/notification keys are loaded from here. -->
        <key>ALLW_API_KEYS_ENV</key>
        <string>/Users/franciscosimao/Documents/QuantFinance/api_keys.env</string>
    </dict>
</dict>
</plist>
